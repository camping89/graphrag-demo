# MongoDB Atlas connection string (BẮT BUỘC)
# Lấy từ: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# OpenAI API key (BẮT BUỘC nếu chưa có sẵn trong env máy)
# Lấy từ: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- Các biến dưới đây là optional, có default trong code ---
# MONGODB_DB=graphrag_demo
# MONGODB_COLLECTION=soc2_entities
# OPENAI_CHAT_MODEL=gpt-5
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
